// ============================================================
// Screen Mapping – ayrı bileşen (onaycı koduna dokunulmaz)
// ============================================================

const MOCK_SCREENS = [
  { screenId: 'SCR-1', screenName: 'Kredi Başvuru Onay Ekranı' },
  { screenId: 'SCR-2', screenName: 'Limit Artırım Onay Ekranı' },
  { screenId: 'SCR-3', screenName: 'Teminat Değerleme Ekranı' },
  { screenId: 'SCR-4', screenName: 'KOBİ Kredi Değerlendirme Ekranı' },
  { screenId: 'SCR-5', screenName: 'Kurumsal Kredi Komite Ekranı' },
];

const mapScreen = (s: any): DropdownOption => ({
  id: String(s.screenId),
  name: s.screenName,
});

/** Mock ekran arama – ileride ctx.search?.screens(query) ile değiştirilebilir. */
function searchScreensMock(query: string): Promise<DropdownOption[]> {
  const q = query.trim().toLowerCase();
  const list = q
    ? MOCK_SCREENS.filter((s) => s.screenName.toLowerCase().includes(q))
    : MOCK_SCREENS;
  return Promise.resolve(list.map(mapScreen));
}

interface ScreenSelectProps {
  id: string;
  elementId: string;
  label: string;
  placeholder: string;
  loadingText: string;
  noResultsText: string;
  tagRemoveTitle: string;
  /** Seçili ekran (tekil). null ise henüz seçilmemiş. */
  selected: ScreenItem | null;
  fetcher: (query: string, signal: AbortSignal) => Promise<DropdownOption[]>;
  onSelect: (option: DropdownOption) => void;
  onClear: () => void;
}

/**
 * Tekil ekran seçimi. Onaycı TagAutocompleteField ile aynı görünüm/davranış,
 * ama seçim tekil: bir ekran seçilince input gizlenir, tek chip gösterilir.
 * Chip × ile temizlenince tekrar input açılır. Aşağı ok / focus ile boşken de
 * tüm liste açılır (min query yok).
 */
function ScreenSelectField(props: ScreenSelectProps) {
  const {
    id,
    elementId,
    label,
    placeholder,
    loadingText,
    noResultsText,
    tagRemoveTitle,
    selected,
    fetcher,
    onSelect,
    onClear,
  } = props;

  const [inputValue, setInputValue] = useState<string>('');

  const containerRef = useRef<HTMLDivElement | null>(null);
  const inputRef = useRef<HTMLInputElement | null>(null);
  const dropdownRef = useRef<HTMLDivElement | null>(null);
  const debounceTimerRef = useRef<number | null>(null);
  const abortControllerRef = useRef<AbortController | null>(null);

  const latestRef = useRef({ onSelect });
  useEffect(() => {
    latestRef.current.onSelect = onSelect;
  });

  // Element değişiminde inputu sıfırla
  useEffect(() => {
    setInputValue('');
    closeDropdown();
  }, [elementId]);

  type DropdownState = {
    isOpen: boolean;
    isLoading: boolean;
    results: DropdownOption[];
  };
  const dropdownStateRef = useRef<DropdownState>({
    isOpen: false,
    isLoading: false,
    results: [],
  });

  function renderDropdown() {
    const div = dropdownRef.current;
    if (!div) return;
    const { isOpen, isLoading, results } = dropdownStateRef.current;

    if (!isOpen) {
      div.style.display = 'none';
      div.innerHTML = '';
      return;
    }

    div.innerHTML = '';
    div.style.display = 'block';

    if (isLoading) {
      const l = document.createElement('div');
      l.textContent = loadingText;
      Object.assign(l.style, { padding: '6px 10px', color: '#888', fontSize: '13px' });
      div.appendChild(l);
      return;
    }

    if (results.length === 0) {
      const e = document.createElement('div');
      e.textContent = noResultsText;
      Object.assign(e.style, { padding: '6px 10px', color: '#888', fontSize: '13px' });
      div.appendChild(e);
      return;
    }

    results.forEach((opt) => {
      const item = document.createElement('div');
      Object.assign(item.style, {
        padding: '6px 10px',
        cursor: 'pointer',
        fontSize: '13px',
      });

      const primary = document.createElement('div');
      primary.textContent = opt.name;
      item.appendChild(primary);

      if (opt.secondary) {
        const sec = document.createElement('div');
        sec.textContent = opt.secondary;
        Object.assign(sec.style, { color: '#888', fontSize: '11px' });
        item.appendChild(sec);
      }

      item.addEventListener('mouseenter', () => {
        item.style.background = '#f0f0f0';
      });
      item.addEventListener('mouseleave', () => {
        item.style.background = 'transparent';
      });
      item.addEventListener('mousedown', (e) => {
        e.preventDefault(); // input blur'u engelle
      });
      item.addEventListener('click', () => {
        const inputEl = inputRef.current;
        if (inputEl) inputEl.value = '';
        setInputValue('');
        closeDropdown();
        latestRef.current.onSelect(opt);
      });
      div.appendChild(item);
    });
  }

  function openDropdown() {
    dropdownStateRef.current.isOpen = true;
    renderDropdown();
  }

  function closeDropdown() {
    dropdownStateRef.current.isOpen = false;
    renderDropdown();
  }

  // Mount: dropdown yarat, outside-click handler
  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const div = document.createElement('div');
    div.className = 'approval-routing-autocomplete-dropdown';
    Object.assign(div.style, {
      position: 'absolute',
      top: '100%',
      left: '0',
      right: '0',
      zIndex: '50',
      background: '#fff',
      border: '1px solid #ccc',
      borderTop: 'none',
      borderRadius: '0 0 3px 3px',
      maxHeight: '220px',
      overflowY: 'auto',
      boxShadow: '0 2px 6px rgba(0,0,0,0.12)',
      display: 'none',
    });
    container.appendChild(div);
    dropdownRef.current = div;

    const onMouseDown = (e: MouseEvent) => {
      const target = e.target as Node | null;
      if (!target) return;
      if (containerRef.current && !containerRef.current.contains(target)) {
        closeDropdown();
      }
    };
    document.addEventListener('mousedown', onMouseDown);

    return () => {
      document.removeEventListener('mousedown', onMouseDown);
      if (debounceTimerRef.current) clearTimeout(debounceTimerRef.current);
      if (abortControllerRef.current) abortControllerRef.current.abort();
      if (div.parentNode) div.parentNode.removeChild(div);
      dropdownRef.current = null;
    };
  }, []);

  function triggerSearch(query: string) {
    if (abortControllerRef.current) abortControllerRef.current.abort();
    const controller = new AbortController();
    abortControllerRef.current = controller;
    dropdownStateRef.current.isLoading = true;
    renderDropdown();

    fetcher(query, controller.signal)
      .then((options) => {
        if (controller.signal.aborted) return;
        dropdownStateRef.current.results = options;
        dropdownStateRef.current.isLoading = false;
        renderDropdown();
      })
      .catch((err) => {
        if ((err && err.name === 'AbortError') || controller.signal.aborted) return;
        dropdownStateRef.current.results = [];
        dropdownStateRef.current.isLoading = false;
        renderDropdown();
      });
  }

  const handleInputChange = useCallback((e: any) => {
    const value: string = e?.target?.value ?? '';
    setInputValue(value);
    openDropdown();

    if (debounceTimerRef.current) clearTimeout(debounceTimerRef.current);
    debounceTimerRef.current = window.setTimeout(() => {
      triggerSearch(value);
    }, DEBOUNCE_MS);
  }, []);

  // focus / aşağı ok davranışı: boşken de tüm listeyi aç
  const handleFocus = useCallback(() => {
    openDropdown();
    triggerSearch(inputRef.current?.value ?? '');
  }, []);

  const inputClassName = 'bio-properties-panel-input';

  const chipContainerStyle: any = {
    display: 'flex',
    flexWrap: 'wrap',
    gap: '4px',
    marginTop: '6px',
  };
  const chipStyle: any = {
    display: 'inline-flex',
    alignItems: 'center',
    gap: '4px',
    padding: '2px 4px 2px 8px',
    background: '#e6f0fa',
    border: '1px solid #b3d4ed',
    borderRadius: '12px',
    fontSize: '12px',
    color: '#1f4f7a',
    maxWidth: '100%',
  };
  const chipTextStyle: any = {
    overflow: 'hidden',
    textOverflow: 'ellipsis',
    whiteSpace: 'nowrap',
  };
  const chipRemoveBtnStyle: any = {
    border: 'none',
    background: 'transparent',
    cursor: 'pointer',
    fontSize: '14px',
    lineHeight: '1',
    padding: '0 4px',
    color: '#1f4f7a',
  };

  return h(
    'div',
    {
      class: 'bio-properties-panel-entry',
      'data-entry-id': id,
      ref: containerRef,
      style: {
        position: 'relative',
        marginBottom: '12px',
        width: '100%',
        display: 'block',
        boxSizing: 'border-box',
        flex: '1 0 100%',
      },
    },
    [
      h(
        'label',
        {
          class: 'bio-properties-panel-label',
          for: `bio-properties-panel-${id}`,
        },
        label
      ),
      // Seçim yoksa input göster, varsa gizle (tekil davranış)
      selected
        ? null
        : h('input', {
            id: `bio-properties-panel-${id}`,
            ref: inputRef,
            type: 'text',
            class: inputClassName,
            spellcheck: false,
            autocomplete: 'off',
            placeholder,
            value: inputValue,
            onInput: handleInputChange,
            onFocus: handleFocus,
            style: { width: '100%', boxSizing: 'border-box' },
          }),
      // Seçili ekran tek chip olarak
      selected
        ? h(
            'div',
            { style: chipContainerStyle },
            [
              h('span', { key: selected.id, style: chipStyle, title: selected.name }, [
                h('span', { style: chipTextStyle }, selected.name),
                h(
                  'button',
                  {
                    type: 'button',
                    style: chipRemoveBtnStyle,
                    title: tagRemoveTitle,
                    onClick: () => onClear(),
                  },
                  '×'
                ),
              ]),
            ]
          )
        : null,
    ].filter(Boolean)
  );
}

export function ScreenMappingEntry(props: { element: any; id: string; ctx: EntryContext }) {
  const { element, id, ctx } = props;
  const state = readApprovalRoutingState(element);

  const fetcher = useCallback(
    (query: string, signal: AbortSignal): Promise<DropdownOption[]> => {
      // ileride: ctx.search?.screens varsa onu kullan, yoksa mock
      const real = ctx.search?.screens;
      if (typeof real === 'function') {
        return (real(query.trim()) ?? Promise.resolve({})).then((res: any) =>
          signal.aborted ? [] : (res?.data?.value ?? []).map(mapScreen)
        );
      }
      return signal.aborted ? Promise.resolve([]) : searchScreensMock(query);
    },
    []
  );

  return h(ScreenSelectField, {
    id,
    elementId: element?.id ?? 'unknown',
    label: 'Ekran',
    placeholder: 'Ekran arayın...',
    loadingText: 'Ekranlar yükleniyor...',
    noResultsText: 'Ekran sonucu yok !',
    tagRemoveTitle: 'Ekranı kaldır',
    selected: state.screen,
    fetcher,
    onSelect: (opt: DropdownOption) => {
      const next = setScreen(state, { id: opt.id, name: opt.name });
      applyState(ctx, element, next);
    },
    onClear: () => {
      const next = clearScreen(state);
      applyState(ctx, element, next);
    },
  });
}






