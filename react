// ============================================================
// Exclude Initiator – akışı başlatan kullanıcı onay veremez (checkbox)
// ============================================================

export function ExcludeInitiatorEntry(props: { element: any; id: string; ctx: EntryContext }) {
  const { element, id, ctx } = props;
  const state = readApprovalRoutingState(element);
  const checked = state.excludeInitiator;

  const handleChange = useCallback(
    (e: any) => {
      const next = setExcludeInitiator(state, !!e?.target?.checked);
      applyState(ctx, element, next);
    },
    [ctx, element, state]
  );

  return h(
    'div',
    {
      class: 'bio-properties-panel-entry',
      'data-entry-id': id,
      style: {
        width: '100%',
        display: 'block',
        boxSizing: 'border-box',
        flex: '1 0 100%',
      },
    },
    [
      h(
        'div',
        {
          style: {
            display: 'flex',
            alignItems: 'center',
            gap: '6px',
          },
        },
        [
          h('input', {
            id: `bio-properties-panel-${id}-checkbox`,
            type: 'checkbox',
            checked,
            onChange: handleChange,
            style: { margin: 0, cursor: 'pointer' },
          }),
          h(
            'label',
            {
              class: 'bio-properties-panel-label',
              for: `bio-properties-panel-${id}-checkbox`,
              style: { cursor: 'pointer', margin: 0 },
            },
            'Akışı başlatan kullanıcı onay veremez'
          ),
        ]
      ),
    ]
  );
}
