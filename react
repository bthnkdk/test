const fileInputRef = useRef<HTMLInputElement>(null);

const handleImportFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
  const file = e.target.files?.[0];
  e.target.value = "";
  if (!file) return;

  try {
    const text = await file.text();
    const bundle = JSON.parse(text);
    const xmlToLoad = bundle.bpmnXml ?? bundle; // düz .bpmn de gelebilir

    const modeler = modelerOrViewerRef.current;
    if (!modeler) return;

    await modeler.importXML(xmlToLoad);

    // isExecutable normalizasyonu (137–150'deki mantığın aynısı)
    const modeling = modeler.get("modeling") as any;
    const canvas = modeler.get("canvas") as any;
    const rootElement = canvas.getRootElement();
    if (rootElement?.businessObject?.isExecutable === false) {
      modeling.updateProperties(rootElement, { isExecutable: true });
    }

    showSnackbarMessage(t("global:import_success"), SNACK_MESSAGE_TYPES.SUCCESS);
  } catch (err) {
    showSnackbarMessage("Diagram içe aktarılamadı: geçersiz dosya.", SNACK_MESSAGE_TYPES.ERROR);
  }
};



<VKButton className="mr-3" onClick={() => fileInputRef.current?.click()}>
  {t("Tasarımı İçe Aktar")}
</VKButton>
<input
  ref={fileInputRef}
  type="file"
  accept=".json,.bpmn,application/json"
  style={{ display: "none" }}
  onChange={handleImportFile}
/>
